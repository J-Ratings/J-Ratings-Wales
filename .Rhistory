row_h <- 1.00
total_w <- sum(col_widths)
total_h <- header_h + max(n, 1L) * row_h
png(
filename = output_file,
width = round(total_w * cfg$output$dpi),
height = round(total_h * cfg$output$dpi),
res = cfg$output$dpi,
type = "cairo"
)
on.exit(
dev.off(),
add = TRUE
)
x_npc <- function(x) x / total_w
y_npc <- function(y) y / total_h
w_npc <- function(w) w / total_w
h_npc <- function(h) h / total_h
grid.newpage()
grid.rect(
x = 0.5,
y = 0.5,
width = unit(1, "npc"),
height = unit(1, "npc"),
gp = gpar(
fill = "#FFEFCC",
col = NA
)
)
x_lefts <- c(0, cumsum(col_widths)[-length(col_widths)])
x_mids <- x_lefts + col_widths / 2
headers <- c("White", "Elo", "Result", "Elo", "Black")
header_y <- total_h - header_h / 2
for (j in seq_along(col_widths)) {
grid.rect(
x = x_npc(x_mids[j]),
y = y_npc(header_y),
width = w_npc(col_widths[j]),
height = h_npc(header_h),
gp = gpar(
fill = cfg$colours$beige,
col = cfg$colours$grid,
lwd = cfg$line$header_lwd
)
)
grid.text(
headers[j],
x = x_npc(x_mids[j]),
y = y_npc(header_y),
gp = gpar(
col = cfg$colours$text,
fontsize = cfg$font$header_size,
fontface = cfg$font$header_face
)
)
}
if (n == 0L) {
body_y <- header_y - header_h / 2 - row_h / 2
grid.rect(
x = 0.5,
y = y_npc(body_y),
width = unit(1, "npc"),
height = h_npc(row_h),
gp = gpar(
fill = "#FFEFCC",
col = cfg$colours$grid,
lwd = cfg$line$body_lwd
)
)
grid.text(
"No results selected",
x = unit(0.5, "npc"),
y = y_npc(body_y),
gp = gpar(
col = cfg$colours$text,
fontsize = cfg$font$body_name_size
)
)
return(invisible(NULL))
}
for (i in seq_len(n)) {
y_top <- total_h - header_h - (i - 1) * row_h
y_mid <- y_top - row_h / 2
values <- c(
results_df$white[i],
as.character(results_df$white_rating[i]),
results_df$result_text[i],
as.character(results_df$black_rating[i]),
results_df$black[i]
)
for (j in seq_along(col_widths)) {
grid.rect(
x = x_npc(x_mids[j]),
y = y_npc(y_mid),
width = w_npc(col_widths[j]),
height = h_npc(row_h),
gp = gpar(
fill = "white",
col = cfg$colours$grid,
lwd = cfg$line$body_lwd
)
)
grid.text(
values[j],
x = x_npc(x_mids[j]),
y = y_npc(y_mid),
gp = gpar(
col = cfg$colours$text,
fontsize = if (j %in% c(1L, 5L)) {
cfg$font$body_name_size
} else {
cfg$font$body_rating_size
},
fontface = if (j %in% c(1L, 5L)) {
cfg$font$player_face
} else if (j == 3L) {
cfg$font$score_face
} else {
"plain"
}
)
)
}
}
}
# One compact image containing both sections, with the height
# automatically adjusted to the number of selected results.
combined_latest_output_file <- file.path(
output_dir,
"2026_27_This_Weeks_Results.png"
)
draw_combined_latest_results <- function(open_df, major_df, output_file, cfg) {
col_widths <- c(5.0, 1.8, 1.8, 1.8, 5.0)
headers <- c("White", "Elo", "Result", "Elo", "Black")
x_lefts <- c(0, head(cumsum(col_widths), -1))
x_mids <- x_lefts + col_widths / 2
total_w <- sum(col_widths)
title_h <- 0.95
section_h <- 0.68
header_h <- 0.95
row_h <- 0.90
section_gap <- 0.22
bottom_margin <- 0.18
section_rows <- function(df) max(nrow(df), 1L)
total_h <- title_h +
2 * (section_h + header_h) +
row_h * (section_rows(open_df) + section_rows(major_df)) +
section_gap + bottom_margin
png(
filename = output_file,
width = round(total_w * cfg$output$dpi),
height = round(total_h * cfg$output$dpi),
res = cfg$output$dpi,
type = "cairo"
)
on.exit(dev.off(), add = TRUE)
x_npc <- function(x) x / total_w
y_npc <- function(y) y / total_h
w_npc <- function(w) w / total_w
h_npc <- function(h) h / total_h
grid.newpage()
grid.rect(gp = gpar(fill = cfg$colours$background, col = NA))
grid.text(
"This Week’s Results",
x = 0.5,
y = y_npc(total_h - title_h / 2),
gp = gpar(col = cfg$colours$text, fontsize = cfg$font$title_size,
fontface = cfg$font$title_face)
)
top <- total_h - title_h
draw_section <- function(df, heading) {
grid.text(
heading,
x = 0.5,
y = y_npc(top - section_h / 2),
gp = gpar(col = cfg$colours$text, fontsize = cfg$font$header_size,
fontface = "bold")
)
top <<- top - section_h
header_y <- top - header_h / 2
for (j in seq_along(col_widths)) {
grid.rect(
x = x_npc(x_mids[j]), y = y_npc(header_y),
width = w_npc(col_widths[j]), height = h_npc(header_h),
gp = gpar(fill = cfg$colours$beige,
col = cfg$colours$grid, lwd = cfg$line$header_lwd)
)
grid.text(
headers[j], x = x_npc(x_mids[j]), y = y_npc(header_y),
gp = gpar(col = cfg$colours$text,
fontsize = cfg$font$header_size,
fontface = cfg$font$header_face)
)
}
top <<- top - header_h
for (i in seq_len(section_rows(df))) {
row_y <- top - row_h / 2
if (nrow(df) == 0L) {
values <- c("No results selected", "", "", "", "")
} else {
values <- c(
df$white[i], as.character(df$white_rating[i]),
df$result_text[i], as.character(df$black_rating[i]),
df$black[i]
)
}
for (j in seq_along(col_widths)) {
grid.rect(
x = x_npc(x_mids[j]), y = y_npc(row_y),
width = w_npc(col_widths[j]), height = h_npc(row_h),
gp = gpar(fill = "white", col = cfg$colours$grid,
lwd = cfg$line$body_lwd)
)
grid.text(
values[j], x = x_npc(x_mids[j]), y = y_npc(row_y),
gp = gpar(
col = cfg$colours$text,
fontsize = if (j %in% c(1L, 5L)) {
cfg$font$body_name_size
} else {
cfg$font$body_rating_size
},
fontface = if (j %in% c(1L, 3L, 5L)) "bold" else "plain"
)
)
}
top <<- top - row_h
}
}
draw_section(open_df, "Open")
top <- top - section_gap
draw_section(major_df, "Major")
invisible(NULL)
}
draw_combined_latest_results(
open_df = latest_open_results,
major_df = latest_major_results,
output_file = combined_latest_output_file,
cfg = cfg
)
open_output_file <- file.path(
output_dir,
"club_championship_open.png"
)
u1800_output_file <- file.path(
output_dir,
"club_championship_u1800.png"
)
draw_crosstable(
players_df = open_data$players %>%
filter(show_crosstable),
cells_df = open_data$cells,
standings_df = open_data$standings,
title = "Club Championship",
output_file = open_output_file,
cfg = cfg
)
draw_crosstable(
players_df = u1800_data$players %>%
filter(show_crosstable),
cells_df = u1800_data$cells,
standings_df = u1800_data$standings,
title = "Club Championship - U1800",
output_file = u1800_output_file,
cfg = cfg
)
message(
"Both crosstables were created successfully.\n",
"Sonneborn-Berger tiebreak: ",
if (isTRUE(cfg$tiebreak$enabled)) "ON" else "OFF",
"\n",
"Championship results loaded: ",
nrow(open_results),
"\n",
"U1800 results loaded: ",
nrow(u1800_results),
"\n",
"Latest Open results exported: ",
nrow(latest_open_results),
"\n",
"Latest Major results exported: ",
nrow(latest_major_results),
"\n",
open_output_file,
"\n",
u1800_output_file,
"\n",
combined_latest_output_file
)
