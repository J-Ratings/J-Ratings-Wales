options(stringsAsFactors = FALSE)
# ── One-time ECF override test runner ─────────────────────────────────────
# Run from repo root:
#   Rscript test_ecf_once.R
#
# This creates a temporary copy of your main script, forces a normal 7-day
# scrape, runs the pipeline, then prints Dave/ECF diagnostics.
script_path <- "j_ratings_with_ecf_override.R"
if (!file.exists(script_path)) {
stop("Cannot find script: ", script_path)
}
list.files(pattern = "\\.R$")
source("C:/Users/stjuk/OneDrive/Documents/GitHub/J-Ratings-Wales/scripts/00_welsh_jratings.r")
# Find Dave in the loaded player data
players_master %>%
filter(grepl("Dave|McGhee", name, ignore.case = TRUE)) %>%
print(n = 20)
# Show possible Dave history files by looking inside data/history
hist_files <- list.files(
file.path(data_dir, "history"),
pattern = "\\.json$",
full.names = TRUE
)
dave_candidates <- lapply(hist_files, function(p) {
x <- tryCatch(jsonlite::read_json(p, simplifyVector = TRUE), error = function(e) NULL)
if (is.null(x) || !is.data.frame(x) || !nrow(x)) return(NULL)
tibble(
file = basename(p),
first_date = suppressWarnings(min(as.Date(x$date), na.rm = TRUE)),
last_date  = suppressWarnings(max(as.Date(x$date), na.rm = TRUE)),
rows = nrow(x)
)
}) %>%
bind_rows()
dave_candidates %>%
arrange(file) %>%
print(n = 200)
if (is.null(seed)) {
stop(
"Cannot seed external override for ", nm,
". Missing J-history on or before ",
format(from_date - 1, "%Y-%m-%d"),
"."
)
}
