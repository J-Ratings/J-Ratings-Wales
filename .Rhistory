third_place = third_place$winners[1],
fourth_place = third_place$losers[1],
group_tables = all_group_tables,
third_placed_ranking = thirds_ranked,
qualified_thirds = qualified_thirds,
third_slot_map = third_slot_map,
r32_pairs = r32_pairs,
matches = all_matches,
finish_table = finish_table,
final_ratings = data.frame(
Team = names(ratings),
Rating = as.numeric(ratings),
stringsAsFactors = FALSE
)
)
}
# -----------------------------
# Load data and apply fallbacks
# -----------------------------
elo_df <- read_elo_file(ELO_FILE)
missing_fallbacks <- fallback_ratings[
!fallback_ratings$Team %in% elo_df$Team,
]
if (nrow(missing_fallbacks) > 0) {
cat(
"Adding fallback ratings for:",
paste(missing_fallbacks$Team, collapse = ", "),
"\n"
)
elo_df <- rbind(elo_df, missing_fallbacks)
}
# -----------------------------
# Run simulations
# -----------------------------
simulations <- vector("list", N_SIM)
for (s in seq_len(N_SIM)) {
cat("Running simulation", s, "of", N_SIM, "\n")
simulations[[s]] <- simulate_world_cup_once(elo_df, sim_id = s)
}
# -----------------------------
# Summary outputs
# -----------------------------
summary_df <- data.frame(
SimID = seq_len(N_SIM),
Champion = vapply(simulations, function(x) x$champion, character(1)),
RunnerUp = vapply(simulations, function(x) x$runner_up, character(1)),
ThirdPlace = vapply(simulations, function(x) x$third_place, character(1)),
FourthPlace = vapply(simulations, function(x) x$fourth_place, character(1)),
stringsAsFactors = FALSE
)
print(summary_df)
# -----------------------------
# Detailed printout for one simulation
# -----------------------------
if (N_SIM == 1L) {
cat("\nGroup tables:\n")
print(simulations[[1]]$group_tables)
cat("\nQualified third-placed teams:\n")
print(simulations[[1]]$qualified_thirds)
cat("\nThird-place slot map:\n")
print(simulations[[1]]$third_slot_map)
cat("\nRound of 32 pairings:\n")
print(simulations[[1]]$r32_pairs)
cat("\nFinal finishing positions:\n")
print(simulations[[1]]$finish_table)
cat("\nAll matches:\n")
print(simulations[[1]]$matches)
}
# -----------------------------
# Save outputs
# -----------------------------
write.csv(
summary_df,
file.path(BASE_DIR, "world_cup_sim_summary.csv"),
row.names = FALSE
)
all_matches_out <- do.call(
rbind,
lapply(simulations, function(x) x$matches)
)
write.csv(
all_matches_out,
file.path(BASE_DIR, "world_cup_sim_matches.csv"),
row.names = FALSE
)
all_group_tables_out <- do.call(
rbind,
lapply(simulations, function(x) x$group_tables)
)
write.csv(
all_group_tables_out,
file.path(BASE_DIR, "world_cup_sim_group_tables.csv"),
row.names = FALSE
)
all_finish_tables_out <- do.call(
rbind,
lapply(simulations, function(x) {
out <- x$finish_table
out$SimID <- x$sim_id
out
})
)
all_finish_tables_out <- all_finish_tables_out[
order(all_finish_tables_out$SimID, all_finish_tables_out$FinishPosition),
]
write.csv(
all_finish_tables_out,
file.path(BASE_DIR, "world_cup_sim_finish_positions.csv"),
row.names = FALSE
)
# -----------------------------
# Stage reach summary
# -----------------------------
stage_rank <- c(
"Eliminated in group stage" = 1L,
"Lost Round of 32" = 2L,
"Lost Round of 16" = 3L,
"Lost quarter-final" = 4L,
"Fourth place" = 5L,
"Third place" = 6L,
"Runner-up" = 7L,
"Champion" = 8L
)
stage_summary_long <- as.data.frame(
table(
Team = all_finish_tables_out$Team,
FinishStage = all_finish_tables_out$FinishStage
),
stringsAsFactors = FALSE
)
stage_summary_long$Count <- as.integer(stage_summary_long$Freq)
stage_summary_long$Freq <- NULL
stage_summary_long$StageRank <- unname(stage_rank[stage_summary_long$FinishStage])
stage_summary_long$Pct <- round(100 * stage_summary_long$Count / N_SIM, 2)
stage_summary_long <- stage_summary_long[
order(stage_summary_long$Team, stage_summary_long$StageRank),
]
write.csv(
stage_summary_long,
file.path(BASE_DIR, "world_cup_sim_stage_counts_long.csv"),
row.names = FALSE
)
all_final_ratings <- do.call(
rbind,
lapply(simulations, function(x) {
out <- x$final_ratings
out$SimID <- x$sim_id
out
})
)
write.csv(
all_final_ratings,
file.path(BASE_DIR, "world_cup_sim_final_ratings.csv"),
row.names = FALSE
)
# -----------------------------
# Extra summary for many simulations
# -----------------------------
if (N_SIM > 1L) {
champion_counts <- as.data.frame(table(summary_df$Champion))
names(champion_counts) <- c("Team", "Titles")
champion_counts$TitlePct <- round(100 * champion_counts$Titles / N_SIM, 2)
champion_counts <- champion_counts[order(-champion_counts$Titles, champion_counts$Team), ]
write.csv(
champion_counts,
file.path(BASE_DIR, "world_cup_sim_champion_odds.csv"),
row.names = FALSE
)
cat("\nChampion counts:\n")
print(champion_counts)
}
cat("\nDone.\n")
cat("Files written to:", BASE_DIR, "\n")
